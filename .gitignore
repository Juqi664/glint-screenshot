# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo lock: this is an application (binary), so Cargo.lock IS committed.
# (Do not delete Cargo.lock for a binary crate.)

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Distribution / packaging outputs
*.deb
*.rpm
*.tar.gz
*.zip
# NOTE: packaging/libs/libgtk4-layer-shell.so.0 IS tracked on purpose — it is
# a build input for `cargo deb` (the lib is not in Ubuntu apt repos), so the
# .deb package is self-contained. See packaging/README for how to regenerate
# it from source.

# Logs / runtime
*.log

# Local environment
.env
.env.local
